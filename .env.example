# 전원마을 파인더 — 환경변수
# 사용법: 이 파일을 .env 로 복사한 뒤 아래 값만 채우세요.
#   cp .env.example .env
# .env 는 .gitignore 로 커밋 제외됨. 환경변수 소비처는 app/backend/config.py 뿐.

# ─────────────────────────────────────────────
# [필수] 공공데이터포털 KRC 서비스키  (활용신청 3종: 15104395 / 15104291 / 15117185)
#   → 마이페이지 > 오픈API > 인증키에서 "일반 인증키(Decoding)" 값을 복사해 아래에 붙여넣기.
#   ※ Decoding(디코딩) 키 권장. Encoding 키(%2B%2F 포함)는 이중 인코딩 오류 위험.
# ─────────────────────────────────────────────
KRC_SERVICE_KEY=

# ─────────────────────────────────────────────
# [선택] LLM 자연어 파서 — 없어도 서비스는 규칙 파서로 그대로 동작합니다.
#
#   ※ 배포(Vercel 등)에서는 넣지 않는 것을 권장합니다.
#     사용자가 화면의 "AI 파싱 켜기"에서 자기 OpenAI 키를 직접 넣는 BYOK 방식을
#     지원하므로, 운영자가 키를 대신 부담할 필요가 없습니다.
#     사용자 키는 그 브라우저 탭에만 보관되며 서버에 저장·기록되지 않습니다.
#
#   로컬 개발에서 매번 입력하기 번거로울 때만 아래 두 줄을 채우세요.
#   (요청에 사용자 키가 오면 그 키가 우선합니다.)
# ─────────────────────────────────────────────
# USE_LLM=1
# OPENAI_API_KEY=sk-여기에_OpenAI_키

# ─────────────────────────────────────────────
# [튜닝용] 기본값 있음 — 건드릴 필요 없으면 그대로 두세요.
# ─────────────────────────────────────────────
# LLM_MODEL_SIMPLE=gpt-5.4-nano
# LLM_MODEL_MEDIUM=gpt-5.4-mini
# LLM_MODEL_COMPLEX=gpt-5.6-luna
# LLM_TIMEOUT_S=20
